{
  "Comment": "DE Project Pipeline — Bronze to Silver to Gold with AI Diagnostic Agent on failure",
  "StartAt": "RunBronzeToSilver",
  "States": {
    "RunBronzeToSilver": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "bronze-to-silver"
      },
      "Next": "RunSilverTransform",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "InvokeDiagnosticAgent",
          "ResultPath": "$.pipeline_error"
        }
      ]
    },
    "RunSilverTransform": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "silver-transform"
      },
      "Next": "RunSilverToGold",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "InvokeDiagnosticAgent",
          "ResultPath": "$.pipeline_error"
        }
      ]
    },
    "RunSilverToGold": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "silver-to-gold"
      },
      "Next": "PipelineSucceeded",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "InvokeDiagnosticAgent",
          "ResultPath": "$.pipeline_error"
        }
      ]
    },
    "InvokeDiagnosticAgent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-south-2:518299481120:function:diagnostic-agent",
        "Payload": {
          "execution_arn.$": "$$.Execution.Id",
          "pipeline_error.$": "$.pipeline_error"
        }
      },
      "ResultPath": null,
      "Next": "PipelineFailed",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "One or more Glue jobs failed — see SNS email for AI diagnosis"
    }
  }
}
